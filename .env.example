# Copy to .env (gitignored) and fill in. Never commit real keys.

# --- LLM providers ---
ANTHROPIC_API_KEY=            # suggestions.py (Suggest Importance and Dependencies)
OPENAI_API_KEY=               # advisor (python -m advisor.evals)
# SPENDLY_LLM_MODEL=claude-haiku-4-5-20251001

# --- LangSmith: traces of the app's LLM code (advisor + suggestions) ---
# Local and evals only. Do NOT set LANGSMITH_TRACING on Railway: the privacy
# page names Anthropic as the only third party that sees Goal data.
LANGSMITH_TRACING=false       # set to true to send traces
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=spendly-app
# EU-region LangSmith accounts only:
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com

FLASK_DEBUG=1
SECRET_KEY=dev-only-change-me
