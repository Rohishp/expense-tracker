# Copy to .env (gitignored) and fill in. Never commit real keys.

# --- LLM providers ---
ANTHROPIC_API_KEY=            # suggestions.py (Suggest Importance and Dependencies)
OPENAI_API_KEY=               # Advisor page and python -m advisor.evals
ADVISOR_MODEL=gpt-5-nano      # Advisor page; without it or OPENAI_API_KEY the Advisor is unavailable
# SAWINGS_LLM_MODEL=claude-haiku-4-5-20251001

# --- LangSmith: traces of the app's LLM code (advisor + suggestions) ---
# Local and evals only. Do NOT set LANGSMITH_TRACING on Railway: the privacy
# page names Anthropic and OpenAI as the only third parties that see Goal data.
LANGSMITH_TRACING=false       # set to true to send traces
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=sawings-app
# EU-region LangSmith accounts only:
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com

FLASK_DEBUG=1
# Signs the login cookie. Required on Railway: without it the app uses a random
# key per process, so logins reset on every restart. Generate one with
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-only-change-me
